---
import { midOf, midUrl } from '../consts';
import Count from './Count.astro';
interface Props { mid: string; counts: Record<string, number> }
const { mid, counts } = Astro.props;
const m = midOf(mid);
---
<ul class="topics">
  {m?.topics.map((x) => (
    <li>
      <a class="topic" href={midUrl(mid, x.slug)}>
        <span>{x.label}</span>
        <Count n={counts[x.slug]} />
      </a>
    </li>
  ))}
</ul>
