---
import { midOf, midUrl } from '../consts';
interface Props { mid: string; counts: Record<string, number> }
const { mid, counts } = Astro.props;
const m = midOf(mid);
---
<ul class="topics">
  {m?.topics.map((x) => (
    <li>
      <a class={counts[x.slug] ? 'topic' : 'topic is-empty'} href={midUrl(mid, x.slug)}>
        <span>{x.label}</span>
        {counts[x.slug] ? <span class="topic-count">{counts[x.slug]}</span> : null}
      </a>
    </li>
  ))}
</ul>
