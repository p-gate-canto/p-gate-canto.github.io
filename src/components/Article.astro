---
import { render, type CollectionEntry } from 'astro:content';
import { AUTHOR_NAME, AUTHOR_BIO, url, midOf, midUrl, pillarOf, pillarUrl, typeOf, typeUrl, tagUrl, fmtDate, isoDate, topicLabel } from '../consts';
import { relatedPosts, readingMinutes, isStale, phraseHtml, nextInSeries } from '../lib';
import PostList from './PostList.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  all: CollectionEntry<'posts'>[];
  preview?: boolean;
}
const { post, all, preview = false } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const mid = midOf(d.category)!;
const pil = pillarOf(mid.pillar)!;
const tLabel = topicLabel(d.category, d.topic);
const type = typeOf(d.type)!;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.filter((h) => h.depth === 2).length >= 3;
const series = preview ? undefined : nextInSeries(post, all);
const related = preview ? [] : relatedPosts(post, all, 4).filter((p) => p.id !== series?.next.id).slice(0, 3);
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;
const minutes = readingMinutes(post.body);
// 受験生向けの記事：読者タグから試験名を決める（1記事につき1つの試験）
const EXAM_NAMES: Record<string, string> = {
  税理士受験生向け: '税理士試験',
  社労士受験生向け: '社会保険労務士試験',
  診断士受験生向け: '中小企業診断士1次試験',
};
const examName = d.tags.map((t) => EXAM_NAMES[t]).find(Boolean);
// サイト内検索の結果カードに出す情報（日付・分類・記事タイプ）は、記事の先頭の hidden の span で渡す
---
{/* 読み進み具合のバーと、目次の「いま読んでいる見出し」の表示（スクリプトは末尾） */}
<div class="read-progress" aria-hidden="true"><span></span></div>
<div class="article-layout">
<article class="article-main" data-pagefind-body={preview ? undefined : ''} data-post-id={preview ? undefined : post.id} data-post-title={preview ? undefined : d.title}>
  {!preview && <Fragment><span hidden data-pagefind-meta={`title:${d.title}`}></span><span hidden data-pagefind-meta={`date:${fmtDate(d.pubDate)}`}></span><span hidden data-pagefind-meta={`category:${tLabel ?? mid.label}`}></span><span hidden data-pagefind-meta={`type:${type.label}`}></span></Fragment>}
  {preview && <p class="preview-banner">下書きプレビューです。公開されておらず、検索にも出ません。</p>}
  <header class="article-head">
    <nav class="crumb" aria-label="現在地" data-pagefind-ignore>
      <a href={url('/')}>ホーム</a> › <a href={pillarUrl(pil.key)}>{pil.en}</a> › <a href={midUrl(d.category)}>{mid.label}</a>{d.topic && tLabel && <Fragment> › <a href={midUrl(d.category, d.topic)}>{tLabel}</a></Fragment>}
    </nav>
    <p class="kicker" data-pagefind-ignore><a href={pillarUrl(pil.key)}>{pil.en}</a>{'\u2003'}<a class="kicker-ja" href={midUrl(d.category)}>{mid.label}</a></p>
    <h1 data-pagefind-ignore set:html={phraseHtml(d.title)} />
    {d.description && <p class="dek" data-pagefind-ignore>{d.description}</p>}
    <div class="article-actions" data-pagefind-ignore>
      <div class="meta">
        <time datetime={isoDate(d.pubDate)}>{fmtDate(d.pubDate)}</time>{d.updatedDate && <Fragment>{'\n'}<span>更新 <time datetime={isoDate(d.updatedDate)}>{fmtDate(d.updatedDate)}</time></span></Fragment>}
        <a class="type-chip" href={typeUrl(type.key)}>{type.label}</a>
        <span>約{minutes}分で読めます</span>
      </div>
      {!preview && <button type="button" class="shiori-btn" aria-pressed="false"><span class="shiori-icon" aria-hidden="true"></span><span class="shiori-off">しおりをはさむ</span><span class="shiori-on">しおり済み</span></button>}
    </div>
    {d.tags.length > 0 && (
      <div class="tags" data-pagefind-ignore>{d.tags.map((t) => <Fragment>{'\n'}{preview ? <span>#{t}</span> : <a href={tagUrl(t)}>#{t}</a>}</Fragment>)}</div>
    )}
    {examName && d.exam.length > 0 && <p class="basedate exam-lead" data-pagefind-ignore>{examName}の{d.exam.map((s) => `「${s}」`).join('')}で問われる内容です。</p>}
    {d.lawBaseDate && <p class="basedate" data-pagefind-ignore>この記事は {fmtDate(d.lawBaseDate)} 時点の法令にもとづいています。</p>}
    {isStale(d.lawBaseDate) && (
      <p class="stale">基準日から1年以上たっています。その後の税制改正・法改正で内容が変わっている可能性があります。</p>
    )}
  </header>

  {showToc && (
    <details class="article-toc toc-inline" open={toc.length <= 6} data-pagefind-ignore>
      <summary class="article-toc-title">この記事の目次<span class="toc-n">{toc.filter((h) => h.depth === 2).length}項目</span></summary>
      <nav aria-label="この記事の目次">
        <ol>
          {toc.map((h) => <li class={`lv${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    </details>
  )}

  <div class="prose"><Content /></div>

  {d.updates.length > 0 && (
    <section class="updates callout callout-note" aria-label="更新履歴" data-pagefind-ignore>
      <p class="callout-label">更新履歴</p>
      <ul>
        {[...d.updates].sort((x, y) => y.date.valueOf() - x.date.valueOf()).map((u) => <li><time datetime={isoDate(u.date)}>{fmtDate(u.date)}</time>{u.note}</li>)}
      </ul>
    </section>
  )}

  <aside class="author" data-pagefind-ignore>
    <span class="author-mark" aria-hidden="true"></span>
    <div>
      <p class="author-name">{AUTHOR_NAME}</p>
      <p class="author-bio">{AUTHOR_BIO}</p>
      <p class="author-links"><a href={url('/about/')}>このブログについて →</a><a href={url('/policy/')}>編集方針 →</a></p>
    </div>
  </aside>

  {series && (
    <section class="series-next" data-pagefind-ignore>
      <h2 class="section-title" data-en="NEXT">次に読む</h2>
      <p class="series-name">{series.wrapped ? `シリーズ「${series.name}」の最初の記事に戻る` : `シリーズ「${series.name}」の${series.index + 1}本目（全${series.total}本）`}</p>
      <PostList posts={[series.next]} />
    </section>
  )}

  {related.length > 0 && (
    <section class="related" data-pagefind-ignore>
      <h2 class="section-title" data-en="RELATED">関連する記事</h2>
      <PostList posts={related} />
    </section>
  )}
  {(newer || older) && (
    <nav class="pager" aria-label="前後の記事" data-pagefind-ignore>
      {older ? <a class="pager-prev" href={url(`/posts/${older.id}/`)}><span>← 前の記事</span>{older.data.title}</a> : <span />}
      {newer ? <a class="pager-next" href={url(`/posts/${newer.id}/`)}><span>次の記事 →</span>{newer.data.title}</a> : <span />}
    </nav>
  )}

</article>
{!preview && (
  <nav class="dock" aria-label="記事の操作" data-pagefind-ignore>
    {showToc ? <button type="button" class="dock-toc">目次</button> : <a href={url('/posts/')}>記事一覧</a>}
    <button type="button" class="shiori-btn" aria-pressed="false"><span class="shiori-icon" aria-hidden="true"></span><span class="shiori-off">しおり</span><span class="shiori-on">しおり済み</span></button>
    <button type="button" class="dock-top">上へ</button>
  </nav>
)}
{showToc ? (
  <aside class="article-side" aria-label="目次" data-pagefind-ignore>
    <nav class="article-toc side-toc">
      <p class="article-toc-title">目次</p>
      <ol>
        {toc.map((h) => <li class={`lv${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </nav>
  </aside>
) : (
  <Sidebar />
)}
</div>
<script is:inline>
  (function () {
    var bar = document.querySelector('.read-progress span');
    var main = document.querySelector('.article-main');
    var links = Array.prototype.slice.call(document.querySelectorAll('.side-toc a'));
    var map = {};
    links.forEach(function (a) { map[decodeURIComponent(a.hash.slice(1))] = a; });
    var heads = Array.prototype.slice.call(document.querySelectorAll('.prose h2[id], .prose h3[id]')).filter(function (h) { return map[h.id]; });
    var current = null;
    function update() {
      if (main && bar) {
        var r = main.getBoundingClientRect();
        var total = r.height - window.innerHeight;
        var p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
        bar.style.transform = 'scaleX(' + p + ')';
      }
      if (!heads.length) return;
      var active = heads[0];
      for (var i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top < 140) active = heads[i]; else break;
      }
      if (active !== current) {
        if (current && map[current.id]) map[current.id].classList.remove('is-current');
        current = active;
        map[current.id].classList.add('is-current');
      }
    }
    var dt = document.querySelector('.dock-toc'), inline = document.querySelector('.toc-inline');
    if (dt && inline) dt.addEventListener('click', function () { inline.open = true; inline.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    var up = document.querySelector('.dock-top');
    if (up) up.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
