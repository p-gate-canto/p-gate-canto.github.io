---
// 分野の地図：柱（WORK・LIFE）ごとに、番号つきで分野を並べる
import { MIDS, midUrl, midNo } from '../consts';
import MidCard from './MidCard.astro';
import Count from './Count.astro';
// compact：トップページ用。分野名だけを1行ずつ並べ、縦に長くならないようにする
interface Props { counts: Record<string, number>; pillar?: string; compact?: boolean }
const { counts, pillar = 'work', compact = false } = Astro.props;
const mids = MIDS.filter((m) => m.pillar === pillar);
---
{compact ? (
  <ul class="mid-links">
    {mids.map((m) => (
      <li><a href={midUrl(m.key)}><span class="toc-no">{midNo(m.key)}</span><span>{m.label}</span><Count n={counts[m.key]} /></a></li>
    ))}
  </ul>
) : (
  <div class="toc">
    {mids.map((m) => <MidCard mid={m.key} count={counts[m.key] ?? 0} no={midNo(m.key)} />)}
  </div>
)}
