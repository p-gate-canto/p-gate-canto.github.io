---
import '../styles/global.css';
import { SITE_TITLE, SITE_SUBTITLE, SITE_DESCRIPTION, FOOTER_NOTE, url } from '../consts';
import Sidebar from '../components/Sidebar.astro';
interface Props {
  title?: string;
  description?: string;
  current?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  jsonld?: object[];
  image?: string; // OGP画像のパス（記事ページは public/og/<slug>.png）。なければ共通の og.png
  // side：本文＋右サイドバー（PCの広い画面だけ）。full：トップページ用の広い1列。plain：記事ページ（自前で目次の列を持つ）
  layout?: 'side' | 'full' | 'plain';
  dock?: boolean; // 記事ページ：スマホ・タブレットの下にガラスのバー（目次・しおり・上へ）を出す
}
const { title, description = SITE_DESCRIPTION, current = '', type = 'website', noindex = false, published, modified, jsonld = [], layout = 'side', image, dock = false } =
  Astro.props;
const pageTitle = title ? `${title}｜${SITE_TITLE}` : `${SITE_TITLE}｜${SITE_SUBTITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image ?? '/og.png'), Astro.site).href;
const nav = [
  { href: url('/'), label: 'ホーム', key: 'home' },
  { href: url('/work/'), label: 'WORK', key: 'work' },
  { href: url('/growth/'), label: 'GROWTH', key: 'growth' },
  { href: url('/posts/'), label: '記事一覧', key: 'posts' },
  { href: url('/about/'), label: 'このブログ', key: 'about' },
  { href: url('/search/'), label: '検索', key: 'search' },
  { href: url('/shiori/'), label: 'しおり', key: 'shiori' },
];
// スマホのメニューとフッターだけに出す補助の入口
const subNav = [
  { href: url('/types/'), label: '記事タイプ', key: 'types' },
  { href: url('/tags/'), label: 'タグ一覧', key: 'tags' },
  { href: url('/rss.xml'), label: 'RSS', key: 'rss' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <slot name="head" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#16161d" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={url('/favicon-96.png')} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="stylesheet" href={url('/fonts/noto-serif-jp/600.css')} />
    <script is:inline>
      /* しおりの保存先：この端末のブラウザ（localStorage）だけ。使えない環境では何もしない */
      window.Shiori = {
        get: function (k, d) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
        set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} },
      };
    </script>
  </head>
  <body class:list={[{ 'has-dock': dock }]}>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={url('/')}>
          <span class="logo-mark" aria-hidden="true"></span>
          <span class="logo-text">{SITE_TITLE}</span>
        </a>
        <nav class="nav" aria-label="メインメニュー">
          {nav.filter((n) => n.key !== 'home').map((n) => <Fragment>{'\n'}<a href={n.href} class:list={[{ 'nav-shiori': n.key === 'shiori' }]} aria-current={current === n.key ? 'page' : undefined}>{n.label}{n.key === 'shiori' && <span class="shiori-count" hidden></span>}</a></Fragment>)}
        </nav>
        <details class="menu">
          <summary aria-label="メニューを開く"><span class="menu-icon" aria-hidden="true"></span>メニュー</summary>
          <nav class="menu-panel" aria-label="メニュー">
            {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.key === 'shiori' ? <span>しおり <span class="shiori-count" hidden></span></span> : n.label}</a>)}
            <div class="menu-sub">{subNav.map((n) => <a href={n.href}>{n.label}</a>)}</div>
          </nav>
        </details>
      </div>
    </header>
    <main class:list={[{ full: layout === 'full' }]}>
      <slot name="hero" />
      {layout === 'side' ? (
        <div class="layout">
          <div class="layout-main"><slot /></div>
          <Sidebar />
        </div>
      ) : (
        <slot />
      )}
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="logo" href={url('/')}>
            <span class="logo-mark" aria-hidden="true"></span>
            <span class="logo-text">{SITE_TITLE}</span>
          </a>
          <p>{SITE_SUBTITLE}</p>
        </div>
        <nav class="footer-nav" aria-label="サイトの案内">
          {[...nav.filter((n) => n.key !== 'home'), ...subNav, { href: url('/policy/'), label: '編集方針' }].map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <p>{FOOTER_NOTE}</p>
        <p>&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
      </div>
    </footer>
    <script is:inline>
      /* しおり（あとで読む）と、読みかけの記録。この端末のブラウザ（localStorage）だけに保存する */
      (function () {
        var S = window.Shiori;
        /* ヘッダー：本文と重なったら（スクロールしたら）すりガラスに */
        var hd = document.querySelector('.site-header');
        var glass = function () { if (hd) hd.classList.toggle('is-glass', scrollY > 8); };
        addEventListener('scroll', glass, { passive: true }); glass();
        function saved() { var v = S.get('shiori:saved', []); return Array.isArray(v) ? v : []; }
        function count() {
          var n = saved().length;
          document.querySelectorAll('.shiori-count').forEach(function (el) { el.textContent = n; el.hidden = !n; });
        }
        var art = document.querySelector('[data-post-id]');
        if (art) {
          var id = art.getAttribute('data-post-id'), title = art.getAttribute('data-post-title'), href = location.pathname;
          var btns = document.querySelectorAll('.shiori-btn');
          var on = function () { return saved().some(function (x) { return x.id === id; }); };
          var paint = function () { var v = on(); btns.forEach(function (b) { b.setAttribute('aria-pressed', v ? 'true' : 'false'); }); };
          btns.forEach(function (b) {
            b.addEventListener('click', function () {
              var list = saved().filter(function (x) { return x.id !== id; });
              if (!on()) list.unshift({ id: id, t: title, u: href, at: Date.now() });
              S.set('shiori:saved', list.slice(0, 200)); paint(); count();
            });
          });
          paint();
          /* 読みかけの位置：本文をどこまで読んだか（0〜1） */
          var main = document.querySelector('.article-main'), tick = 0;
          var record = function () {
            tick = 0; if (!main) return;
            var r = main.getBoundingClientRect(), total = r.height - innerHeight;
            var p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
            var prog = S.get('shiori:progress', {}) || {};
            prog[id] = { t: title, u: href, p: Math.max(p, (prog[id] && prog[id].p) || 0), at: Date.now() };
            var keys = Object.keys(prog).sort(function (a, b) { return prog[b].at - prog[a].at; });
            keys.slice(30).forEach(function (k) { delete prog[k]; });
            S.set('shiori:progress', prog);
          };
          addEventListener('scroll', function () { if (!tick) tick = setTimeout(record, 600); }, { passive: true });
          setTimeout(record, 1500);
          /* 「続きから読む」で来たとき（?r=0.42）は、その位置まで送る */
          var m = /[?&]r=(0\.\d+)/.exec(location.search);
          if (m && main) setTimeout(function () {
            var r = main.getBoundingClientRect(), total = r.height - innerHeight;
            scrollTo(0, scrollY + r.top + total * Number(m[1]));
          }, 50);
        }
        count();
      })();
    </script>
  </body>
</html>
