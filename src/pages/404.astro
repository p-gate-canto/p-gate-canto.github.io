---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { url } from '../consts';
---
<Base title="ページが見つかりません" noindex>
  <script is:inline slot="head">
    // 旧URL（/zeirishi-shiori/〜、/contents/、/category/〜、/tools/）を新しいURLへ転送する。
    // 画面を描く前に実行し、「ページが見つかりません」が一瞬見えないようにする（ヘッダーだけ残し、本文とフッターを隠す）
    (function () {
      var OLD = {
        strategy: '/work/strategy/', finance: '/work/finance/', tax: '/work/tax/',
        bizdev: '/work/innovation/', ma: '/work/ma/', marketing: '/work/marketing/', hr: '/work/hr/',
        dx: '/work/dx/', risk: '/work/strategy/', study: '/life/study/', self: '/life/', work: '/life/',
      };
      var p = location.pathname;
      var n = p.replace(/^\/zeirishi-shiori(?=\/|$)/, '') || '/';
      if (n === '/contents/') n = '/work/';
      if (n === '/tools/') n = '/types/tool/';
      var m = n.match(/^\/category\/([\w-]+)\//);
      if (m) n = OLD[m[1]] || '/';
      if (n !== p) {
        document.documentElement.classList.add('redirecting');
        location.replace(n + location.search + location.hash);
      }
    })();
  </script>
  <PageHero slot="hero" title="ページが見つかりません" lead="移転や整理により、URLが変わった可能性があります。" />
  <section class="section">
    <div class="wrap">
      <div class="cats">
        <a class="cat" href={url('/')}><strong>トップページ</strong><span class="cat-desc">新着記事と、読む人別の入口</span></a>
        <a class="cat" href={url('/work/')}><strong>WORK</strong><span class="cat-desc">経営戦略・税務・人事労務など13分野の地図</span></a>
        <a class="cat" href={url('/search/')}><strong>サイト内検索</strong><span class="cat-desc">キーワードで記事を探す</span></a>
      </div>
    </div>
  </section>
</Base>
