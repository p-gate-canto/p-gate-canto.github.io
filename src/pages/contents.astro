---
import Base from '../layouts/Base.astro';
import TopicGrid from '../components/TopicGrid.astro';
import { CATEGORIES, MAIN_KEYS, catUrl, url } from '../consts';
import { getPosts } from '../lib';
import { breadcrumbLd } from '../seo';
const all = await getPosts();
const counts: Record<string, number> = {};
for (const p of all) if (p.data.topic) counts[p.data.topic] = (counts[p.data.topic] ?? 0) + 1;
---
<Base title="仕事の目次" description="経営・財務・税務・人事・DXなど、仕事の9分野の目次" current="business" jsonld={[breadcrumbLd([['仕事', url('/contents/')]])]}>
  <section class="hero">
    <div class="wrap">
      <h1>仕事</h1>
      <p>経営・財務・税務・人事・DXなど、9つの分野と、その中の項目です。</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {MAIN_KEYS.map((k, i) => (
        <div class="toc-block">
          <h2 class="toc-head">
            <span class="toc-no">{String(i + 1).padStart(2, '0')}</span>
            <a href={catUrl(k)}>{CATEGORIES[k].label}</a>
            <span class="toc-en">{CATEGORIES[k].en}</span>
          </h2>
          <TopicGrid cat={k} counts={counts} />
        </div>
      ))}
    </div>
  </section>
</Base>
