---
// 記事一覧：公開中の記事を新しい順にすべて並べる
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib';
import { breadcrumbLd } from '../../seo';
const posts = await getPosts();
---
<Base title="記事一覧" description={`税理士のしおりの記事一覧。公開中の${posts.length}本を新しい順に並べています。`} current="posts" jsonld={[breadcrumbLd([['記事一覧', Astro.url.pathname]])]}>
  <PageHero slot="hero" title="記事一覧" lead={`公開中の${posts.length}本を、新しい順に並べています。`} />
  <section class="section">
    <div class="wrap">
      <PostList posts={posts} />
    </div>
  </section>
</Base>
