---
import PostList from '../../components/PostList.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { url, fmtDate } from '../../consts';
import { getDrafts } from '../../lib';
const drafts = await getDrafts();
---
<Base title="下書き一覧" noindex>
  <PageHero slot="hero" title="下書き一覧" lead="公開前の記事のプレビューです。このページは検索に出ません。" />
  <section class="section">
    <div class="wrap">
      <PostList posts={drafts} base="/drafts/" empty="下書きはありません。" />
    </div>
  </section>
</Base>
