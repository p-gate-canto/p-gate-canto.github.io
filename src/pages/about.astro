---
import Base from '../layouts/Base.astro';
// 本文は src/content/pages/about.md（Pages CMS の「このブログについて」）で編集する
import { Content, frontmatter } from '../content/pages/about.md';
---
<Base title={frontmatter.title} description={frontmatter.description} current="about">
  <article class="wrap">
    <header class="article-head"><h1>{frontmatter.title}</h1></header>
    <div class="prose"><Content /></div>
  </article>
</Base>
