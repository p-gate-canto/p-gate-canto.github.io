---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';
import { getPosts } from '../../lib';
export function getStaticPaths() {
  return (Object.keys(CATEGORIES) as CategoryKey[])
    .filter((k) => k !== 'tools')
    .map((cat) => ({ params: { cat } }));
}
const cat = Astro.params.cat as CategoryKey;
const info = CATEGORIES[cat];
const posts = (await getPosts()).filter((p) => p.data.category === cat);
---
<Base title={info.label} description={info.desc} current={cat}>
  <section class="hero"><div class="wrap">
    <h1>{info.label}</h1><p>{info.desc}</p>
  </div></section>
  <section class="section"><div class="wrap"><PostList posts={posts} /></div></section>
</Base>
