---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import TopicGrid from '../../../components/TopicGrid.astro';
import { CATEGORIES, CATEGORY_KEYS, MAIN_KEYS, url, type CategoryKey } from '../../../consts';
import { getPosts } from '../../../lib';
import { breadcrumbLd } from '../../../seo';
export function getStaticPaths() {
  return CATEGORY_KEYS.filter((k) => k !== 'tools').map((cat) => ({ params: { cat } }));
}
const cat = Astro.params.cat as CategoryKey;
const info = CATEGORIES[cat];
const posts = (await getPosts()).filter((p) => p.data.category === cat);
const counts: Record<string, number> = {};
for (const p of posts) if (p.data.topic) counts[p.data.topic] = (counts[p.data.topic] ?? 0) + 1;
const idx = MAIN_KEYS.indexOf(cat);
const crumbs: [string, string][] = idx >= 0 ? [['仕事', url('/contents/')]] : [];
crumbs.push([info.label, Astro.url.pathname]);
---
<Base title={info.label} description={`${info.label}（${info.en}）の記事一覧`} current={idx >= 0 ? 'business' : cat} noindex={posts.length === 0} jsonld={[breadcrumbLd(crumbs)]}>
  <section class="hero">
    <div class="wrap">
      {idx >= 0 && <p class="crumb"><a href={url('/contents/')}>仕事</a></p>}
      <h1>{idx >= 0 && <span class="hero-no">{String(idx + 1).padStart(2, '0')}</span>}{info.label}</h1>
      <p>{info.en}</p>
    </div>
  </section>
  {info.topics.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="section-title">項目</h2>
        <TopicGrid cat={cat} counts={counts} />
      </div>
    </section>
  )}
  <section class="section">
    <div class="wrap">
      <h2 class="section-title">記事</h2>
      <PostList posts={posts} />
    </div>
  </section>
</Base>
