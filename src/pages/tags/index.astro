---
import Count from '../../components/Count.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { TAG_GROUPS, tagUrl } from '../../consts';
import { getPosts, countBy } from '../../lib';
const counts = countBy(await getPosts());
---
<Base title="タグ一覧" description="読者・会社のステージ・業種・時事などの切り口から探す" noindex>
  <PageHero slot="hero" title="タグ一覧" lead="読者・会社のステージ・業種などの切り口から探せます。" />
  <section class="section">
    <div class="wrap">
      {TAG_GROUPS.map((g) => (
        <section class="layer">
          <h3 class="layer-head">{g.group}</h3>
          <ul class="topics">
            {g.tags.map((t) => (
              <li><a class="topic" href={tagUrl(t)}><span>{t}</span><Count n={counts[`tag:${t}`]} /></a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>
