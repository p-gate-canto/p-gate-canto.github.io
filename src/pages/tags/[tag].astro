---
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { ALL_TAGS, READERS, url } from '../../consts';
import { getPosts } from '../../lib';
export async function getStaticPaths() {
  const posts = await getPosts();
  return ALL_TAGS.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
const reader = READERS.find((r) => r.tag === tag);
---
<Base title={reader ? reader.label : `#${tag}`} description={`タグ「${tag}」の記事一覧`} noindex>
  <PageHero title={reader ? reader.label : `#${tag}`} lead={reader ? reader.desc : `タグ「${tag}」の記事`} crumbs={[['タグ', url('/tags/')]]} />
  <section class="section">
    <div class="wrap">
      <PostList posts={posts} empty="このタグの記事は準備中です。" />
    </div>
  </section>
</Base>
