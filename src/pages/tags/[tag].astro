---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { ALL_TAGS, READERS, url } from '../../consts';
import { getPosts } from '../../lib';
export async function getStaticPaths() {
  const posts = await getPosts();
  return ALL_TAGS.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
const reader = READERS.find((r) => r.tag === tag);
---
<Base title={reader ? reader.label : `#${tag}`} description={`タグ「${tag}」の記事一覧`} noindex>
  <section class="hero">
    <div class="wrap">
      <p class="crumb"><a href={url('/tags/')}>タグ</a></p>
      <h1>{reader ? reader.label : `#${tag}`}</h1>
      <p>{reader ? reader.desc : `タグ「${tag}」の記事`}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {posts.length === 0 ? <p class="empty">このタグの記事は準備中です。</p> : <PostList posts={posts} />}
    </div>
  </section>
</Base>
