---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import WorkMap from '../components/WorkMap.astro';
import Count from '../components/Count.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_KEYWORDS, PILLARS, READERS, TYPES, MIDS, AUTHOR_NAME, AUTHOR_BIO, url, pillarUrl, tagUrl, typeUrl } from '../consts';
import { getPosts, countBy } from '../lib';
import { websiteLd } from '../seo';
const all = await getPosts();
const counts = countBy(all);
const featuredTypes = ['glossary', 'news', 'checklist', 'tool'].map((k) => TYPES.find((t) => t.key === k)!);
---
<Base current="home" jsonld={[websiteLd()]}>
  <section class="hero hero-home">
    <div class="wrap">
      <h1>{SITE_TITLE}</h1>
      <p>{SITE_TAGLINE}</p>
      <form class="hero-search" action={url('/search/')} method="get" role="search">
        <input type="search" name="q" placeholder="例：役員報酬、源泉徴収" aria-label="サイト内検索" />
        <button type="submit">検索</button>
      </form>
      {SITE_KEYWORDS.length > 0 && (
        <p class="hero-keywords">
          <span class="kw-label">よく読まれているテーマ</span>
          {SITE_KEYWORDS.map((k) => <a href={`${url('/search/')}?q=${encodeURIComponent(k)}`}>{k}</a>)}
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">新着記事</h2>
      <PostList posts={all.slice(0, 6)} />
    </div>
  </section>

  <section class="section section-band">
    <div class="wrap">
      <h2 class="section-title">読む人から探す</h2>
      <p class="section-lead">立場に合わせて、役に立つ記事をまとめています。</p>
      <div class="cats cats-4">
        {READERS.map((r) => (
          <a class="cat" href={tagUrl(r.tag)}>
            <strong>{r.label}</strong>
            <span class="cat-desc">{r.desc}</span>
            <span class="card-meta"><Count n={counts[`tag:${r.tag}`]} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">3つの柱</h2>
      <div class="cats cats-3">
        {PILLARS.map((p) => (
          <a class="cat" href={pillarUrl(p.key)}>
            <span class="cat-en">{p.en}</span>
            <strong>{p.label}</strong>
            <span class="cat-desc">{p.desc}</span>
            <span class="card-meta"><span>{MIDS.filter((m) => m.pillar === p.key).length}分野</span><Count n={counts[`pillar:${p.key}`]} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">WORKの地図</h2>
      <WorkMap counts={counts} compact />
      <p class="more"><a href={pillarUrl('work')}>WORKの全分野を見る →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">記事タイプから探す</h2>
      <div class="cats">
        {featuredTypes.map((t) => (
          <a class="cat" href={typeUrl(t.key)}>
            <strong>{t.label}</strong>
            <span class="cat-desc">{t.desc}</span>
            <span class="card-meta"><Count n={counts[`type:${t.key}`]} /></span>
          </a>
        ))}
      </div>
      <p class="more"><a href={url('/types/')}>すべての記事タイプ →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <aside class="author">
        <span class="author-mark" aria-hidden="true"></span>
        <div>
          <p class="author-name">{AUTHOR_NAME}</p>
          <p class="author-bio">{AUTHOR_BIO}</p>
          <a href={url('/about/')}>このブログについて →</a>
        </div>
      </aside>
    </div>
  </section>
</Base>
