---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TocCard from '../components/TocCard.astro';
import { SITE_TITLE, SITE_TAGLINE, MAIN_KEYS, PILLARS, url } from '../consts';
import { getPosts } from '../lib';
import { websiteLd } from '../seo';
const all = await getPosts();
const posts = all.slice(0, 10);
const countOf = (cat: string) => all.filter((p) => p.data.category === cat).length;
const pillarCount = (key: string) =>
  key === 'business' ? all.filter((p) => (MAIN_KEYS as string[]).includes(p.data.category)).length : countOf(key);
---
<Base current="home" jsonld={[websiteLd()]}>
  <section class="hero">
    <div class="wrap">
      <h1>{SITE_TITLE}</h1>
      <p>{SITE_TAGLINE}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="section-title">新着記事</h2>
      <PostList posts={posts} />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="section-title">3つの柱</h2>
      <div class="pillars">
        {PILLARS.map((p) => (
          <a class="pillar" href={url(p.href)}>
            <span class="pillar-en">{p.en}</span>
            <strong>{p.label}</strong>
            <span class="pillar-desc">{p.desc}</span>
            <span class="toc-count">{pillarCount(p.key)}記事</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="section-title">仕事の目次</h2>
      <div class="toc">
        {MAIN_KEYS.map((k) => <TocCard cat={k} count={countOf(k)} />)}
      </div>
      <p class="more"><a href={url('/contents/')}>すべての項目を見る →</a></p>
    </div>
  </section>
</Base>
