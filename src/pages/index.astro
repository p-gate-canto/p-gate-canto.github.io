---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE_TITLE, SITE_TAGLINE, CATEGORIES, url } from '../consts';
import { getPosts } from '../lib';
const posts = (await getPosts()).slice(0, 10);
---
<Base current="home">
  <section class="hero"><div class="wrap">
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_TAGLINE}</p>
  </div></section>
  <section class="section"><div class="wrap">
    <h2 class="section-title">新着記事</h2>
    <PostList posts={posts} />
  </div></section>
  <section class="section"><div class="wrap">
    <h2 class="section-title">カテゴリ</h2>
    <div class="cats">
      {Object.entries(CATEGORIES).map(([key, c]) => (
        <a class="cat" href={key === 'tools' ? url('/tools/') : url(`/category/${key}/`)}>
          <strong>{c.label}</strong><span>{c.desc}</span>
        </a>
      ))}
    </div>
  </div></section>
</Base>
