---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { TYPES, url } from '../../consts';
import { getPosts } from '../../lib';
import { breadcrumbLd } from '../../seo';
export function getStaticPaths() {
  return TYPES.map((t) => ({ params: { type: t.key }, props: { t } }));
}
const { t } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.type === t.key);
---
<Base title={t.label} description={`${t.desc}の記事一覧`} current="types" noindex={posts.length === 0} jsonld={[breadcrumbLd([['記事タイプ', url('/types/')], [t.label, Astro.url.pathname]])]}>
  <section class="hero">
    <div class="wrap">
      <p class="crumb"><a href={url('/types/')}>記事タイプ</a></p>
      <h1>{t.label}</h1>
      <p>{t.desc}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {posts.length === 0 ? <p class="empty">この記事タイプの記事は準備中です。</p> : <PostList posts={posts} />}
    </div>
  </section>
</Base>
