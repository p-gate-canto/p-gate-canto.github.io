---
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Refine from '../../components/Refine.astro';
import { TYPES, url } from '../../consts';
import { getPosts } from '../../lib';
import { breadcrumbLd } from '../../seo';
export function getStaticPaths() {
  return TYPES.map((t) => ({ params: { type: t.key }, props: { t } }));
}
const { t } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.type === t.key);
---
<Base title={t.label} description={`${t.desc}の記事一覧`} current="types" noindex={posts.length === 0} jsonld={[breadcrumbLd([['記事タイプ', url('/types/')], [t.label, Astro.url.pathname]])]}>
  <PageHero slot="hero" title={t.label} lead={t.desc} crumbs={[['記事タイプ', url('/types/')]]} />
  <section class="section">
    <div class="wrap">
      <Refine posts={posts} />
      <PostList posts={posts} empty="この記事タイプの記事は準備中です。" />
    </div>
  </section>
</Base>
