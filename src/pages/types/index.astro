---
import Count from '../../components/Count.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { TYPES, typeUrl } from '../../consts';
import { getPosts, countBy } from '../../lib';
const counts = countBy(await getPosts());
---
<Base title="記事タイプ" description="解説・比較・チェックリスト・改正ニュースなど、記事の型から探す" current="types">
  <PageHero title="記事タイプ" lead="記事の書き方の型から探せます。" />
  <section class="section">
    <div class="wrap">
      <div class="cats">
        {TYPES.map((t) => (
          <a class="cat" href={typeUrl(t.key)}>
            <strong>{t.label}</strong>
            <span class="cat-desc">{t.desc}</span>
            <span class="card-meta"><Count n={counts[`type:${t.key}`]} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
